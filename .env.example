# Konfigurasi Firebase. Salin file ini ke .env.local lalu isi nilainya
# (dipakai oleh npm run dev, npm run build, dan npm run build:cloudrun).
VITE_FIREBASE_API_KEY=YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Konfigurasi Google Gemini AI (Model Terbaru: Gemini 3.8 Flash)
# Dapatkan API Key di: https://aistudio.google.com/
# Hanya untuk pengembangan lokal. Build Cloud Run mengosongkan nilai ini (.env.cloudrun);
# di sana Gemini dipanggil lewat proxy server.mjs dengan GEMINI_API_KEY milik server.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
VITE_GEMINI_MODEL=gemini-3.8-flash


